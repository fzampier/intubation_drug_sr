UR  - https://search.library.ualberta.ca/openurl/01UOA_INST/01UOA_INST:UOA?sid=OVID:embase&id=pmid:22788915&id=doi:10.1111%2Fj.1540-8167.2012.02393.x&issn=1045-3873&isbn=&volume=23&issue=12&spage=1313&pages=1313-1316&date=2012&title=Journal+of+Cardiovascular+Electrophysiology&atitle=A+randomized-controlled+pilot+study+comparing+ICD+implantation+with+and+without+intraoperative+defibrillation+testing+in+patients+with+heart+failure+and+severe+left+ventricular+dysfunction%3A+A+substudy+of+the+RAFT+trial&aulast=Healey&pid=%3Cauthor%3EHealey+J.S.%2CGula+L.J.%2CBirnie+D.H.%2CSterns+L.%2CConnolly+S.J.%2CSapp+J.%2CCrystal+E.%2CSimpson+C.%2CExner+D.V.%2CKus+T.%2CPhilippon+F.%2CWells+G.%2CTang+A.S.%3C%2Fauthor%3E%3CAN%3E52114506%3C%2FAN%3E%3CDT%3EArticle%3C%2FDT%3E
