UR  - https://search.library.ualberta.ca/openurl/01UOA_INST/01UOA_INST:UOA?sid=OVID:embase&id=pmid:26388272&id=doi:10.5505%2Ftjtes.2015.06325&issn=1306-696X&isbn=&volume=21&issue=5&spage=358&pages=358-365&date=2015&title=Ulusal+Travma+ve+Acil+Cerrahi+Dergisi&atitle=Acil+entubasyon+sirasinda+tek+doz+etomidatin+hemodinami+ve+adrenal+korteks+uzerine+etkisi&aulast=Koksal&pid=%3Cauthor%3EKoksal+G.M.%2CErbabacan+E.%2CTunali+Y.%2CKaraoren+G.%2CVehid+S.%2COz+H.%3C%2Fauthor%3E%3CAN%3E605929150%3C%2FAN%3E%3CDT%3EArticle%3C%2FDT%3E
