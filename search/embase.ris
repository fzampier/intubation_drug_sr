UR  - https://search.library.ualberta.ca/openurl/01UOA_INST/01UOA_INST:UOA?sid=OVID:embase&id=pmid:39283873&id=doi:10.1371%2Fjournal.pone.0307723&issn=1932-6203&isbn=&volume=19&issue=9+Septeber&spage=&pages=&date=2024&title=PLOS+ONE&atitle=Impact+of+non-invasive+oxygen+reserve+index+versus+standard+SpO2+monitoring+on+peripheral+oxygen+saturation+during+endotracheal+intubation+in+the+intensive+care+unit%3A+Protocol+for+the+randomized+controlled+trial+NESOI2&aulast=Hille&pid=%3Cauthor%3EHille+H.%2CLe+Thuaut+A.%2CAsfar+P.%2CQuelven+Q.%2CMercier+E.%2CLe+Meur+A.%2CQuenot+J.-P.%2CLemiale+V.%2CMuller+G.%2CCour+M.%2CFerre+A.%2CBerge+A.%2CCurtiaud+A.%2CTouron+M.%2CPlantefeve+G.%2CChakarian+J.-C.%2CRicard+J.-D.%2CColin+G.%2COrieux+A.%2CGirardie+P.%2CJozwiak+M.%2CRouaud+M.%2CJuhel+C.%2CReignier+J.%2CLascarrou+J.-B.%3C%2Fauthor%3E%3CAN%3E2034596054%3C%2FAN%3E%3CDT%3EArticle%3C%2FDT%3E
